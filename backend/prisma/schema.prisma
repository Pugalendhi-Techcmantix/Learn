// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "mysql"
}

// Roles are rows, not a fixed list, so a role can carry more data and new roles
// need no schema change. Names used by the code live in src/lib/roles.ts.
model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  users       User[]
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String
  roleId       Int
  // Restrict: a role that still has users cannot be deleted.
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([roleId])
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String
  category  String
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
}
