# Copy to .env. Vite only exposes variables that start with VITE_.
# Base URL of the backend API (no trailing slash).
VITE_API_URL=http://localhost:4000

# Development only: enables the local test-account fill buttons.
# Use the same value as backend/SEED_TEST_PASSWORD. Never set this in production.
VITE_TEST_PASSWORD=choose-a-local-test-password
